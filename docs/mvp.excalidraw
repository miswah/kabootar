      "isDeleted": false,
      "boundElements": [],
      "updated": 1786291199543,
      "link": null,
      "locked": false,
      "text": "{\n    \"ap-south-1\": {\n         \"status\": \"HEALTHY\",\n         \"weight\": 60,\n         \"latency\": 35\n    }\n}",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n    \"ap-south-1\": {\n         \"status\": \"HEALTHY\",\n         \"weight\": 60,\n         \"latency\": 35\n    }\n}",
      "autoResize": true,
