      "isDeleted": false,
      "boundElements": null,
      "updated": 1786289617019,
      "link": null,
      "locked": false,
      "text": "Service: payment-service\n\nRegion weights:\n- ap-south-1: 70%\n- ap-southeast-1: 20%\n- eu-west-1: 10%",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Service: payment-service\n\nRegion weights:\n- ap-south-1: 70%\n- ap-southeast-1: 20%\n- eu-west-1: 10%",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xe7TOr2K1ZYdoNhIVa_pA",
      "type": "text",
      "x": 595.823819438339,
      "y": 2330.9261816798216,
      "width": 844.4000244140625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1731588255,
      "version": 117,
      "versionNonce": 977475455,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786289330890,
      "link": null,
      "locked": false,
      "text": "If ap-south-1 becomes unhealthy we shift traffic to the next\navailable node ie ap-southeast-1",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If ap-south-1 becomes unhealthy we shift traffic to the next\navailable node ie ap-southeast-1",
      "autoResize": true,
      "lineHeight": 1.25
    },
