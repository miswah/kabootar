    },
    {
      "id": "66Zwf4DuTEL1bSVQVBO0l",
      "type": "text",
      "x": 1513.3000099145295,
      "y": 1155.02141977506,
      "width": 827.0333251953125,
      "height": 490,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1480486687,
      "version": 506,
      "versionNonce": 1357703057,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786290539533,
      "link": null,
      "locked": false,
      "text": "User traffic get routed to the lowest latency and the\nsystem become more resilient.\n\nthis service sits in the request gateway pipeline\n\nreq > security > rate limiter > traffic distribution \n                                > load Balancing > backend service\n\nThe main job of this module is to determine which region\nshould serve the rquest.\n\nComponents of the Traffic Distribution Engine\n1. Region Registry - metadata for each region\n    ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User traffic get routed to the lowest latency and the\nsystem become more resilient.\n\nthis service sits in the request gateway pipeline\n\nreq > security > rate limiter > traffic distribution \n                                > load Balancing > backend service\n\nThe main job of this module is to determine which region\nshould serve the rquest.\n\nComponents of the Traffic Distribution Engine\n1. Region Registry - metadata for each region\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZkQAVUlwQsV6S_o3iluYJ",
      "type": "text",
      "x": 1545.9676773808737,
      "y": 1618.0541634020065,
      "width": 446.6000061035156,
      "height": 245,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
